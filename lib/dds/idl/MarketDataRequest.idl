#include "Header.idl"

module DistributedStockExchange_MarketDataRequest
{

	struct NoMDEntryTypes
	{
		char MDEntryType;
	};
	typedef sequence<NoMDEntryTypes> NoMDEntryTypesSeq;

	struct NoRelatedSym
	{
		string Symbol;
		string SecurityExchange;
	};
	typedef sequence<NoRelatedSym> NoRelatedSymSeq;

	
	struct MarketDataRequest
	{
		string Source;
     		string Destination;
    		string SourceUser;
    		string DestinationUser;


		DistributedStockExchange::Header fix_header;

		string MDReqID;
		char SubscriptionRequestType;
		long MarketDepth;
		NoMDEntryTypesSeq c_NoMDEntryTypes;
		NoRelatedSymSeq c_NoRelatedSym;
	};
};
